<Window x:Class="VnSpoofer.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="VnSpoofer" Height="660" Width="960" WindowStartupLocation="CenterScreen"
        WindowStyle="None" ResizeMode="CanMinimize" Background="{StaticResource Bg}">
  <Border BorderBrush="{StaticResource Line}" BorderThickness="1">
    <Grid>
      <Grid.RowDefinitions>
        <RowDefinition Height="52"/><RowDefinition Height="*"/><RowDefinition Height="64"/>
      </Grid.RowDefinitions>
      <Border Grid.Row="0" Background="{StaticResource Panel}" MouseLeftButtonDown="Drag">
        <Grid Margin="18,0">
          <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
            <TextBlock Text="VN" FontSize="15" FontWeight="Bold" Foreground="{StaticResource Accent}"/>
            <TextBlock Text="SPOOFER" FontSize="15" FontWeight="Bold" Margin="4,0,16,0"/>
            <Border x:Name="Pill" Background="{StaticResource Panel2}" CornerRadius="20" Padding="10,4" VerticalAlignment="Center">
              <TextBlock x:Name="PillText" Text="INACTIF" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource Muted}"/>
            </Border>
          </StackPanel>
          <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
            <Button Content="-" Style="{StaticResource Btn}" Padding="14,4" Click="Min_Click" Margin="0,0,6,0"/>
            <Button Content="X" Style="{StaticResource Btn}" Padding="14,4" Click="Close_Click"/>
          </StackPanel>
        </Grid>
      </Border>
      <Grid Grid.Row="1" Margin="16">
        <Grid.ColumnDefinitions><ColumnDefinition Width="252"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
        <Border Grid.Column="0" Style="{StaticResource Card}">
          <StackPanel>
            <TextBlock Text="MODULES" Style="{StaticResource Mono}" Margin="0,0,0,8"/>
            <CheckBox x:Name="ChkDisk" Content="Serial disque" IsChecked="True"/>
            <CheckBox x:Name="ChkVolume" Content="Serial volume" IsChecked="True"/>
            <CheckBox x:Name="ChkSmbios" Content="SMBIOS (UUID / CM / BIOS)" IsChecked="True"/>
            <CheckBox x:Name="ChkMac" Content="Adresse MAC" IsChecked="True"/>
            <CheckBox x:Name="ChkGuid" Content="MachineGuid" IsChecked="True"/>
            <CheckBox x:Name="ChkGpu" Content="GPU (reboot requis)" Foreground="{StaticResource Warn}"/>
            <Separator Margin="0,14" Background="{StaticResource Line}"/>
            <TextBlock Text="PROVIDER KDU" Style="{StaticResource Mono}" Margin="0,0,0,6"/>
            <ComboBox x:Name="CmbProvider" SelectedIndex="0"><ComboBoxItem Content="Auto (rotatif)"/></ComboBox>
            <Separator Margin="0,14" Background="{StaticResource Line}"/>
            <TextBlock Text="APEX" Style="{StaticResource Mono}" Margin="0,0,0,6"/>
            <CheckBox x:Name="ChkLaunch" Content="Lancer Apex apres spoof" IsChecked="True"/>
            <CheckBox x:Name="ChkCleanBefore" Content="Cleaner avant spoof" IsChecked="True"/>
          </StackPanel>
        </Border>
        <Grid Grid.Column="1" Margin="14,0,0,0">
          <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
          <Border Grid.Row="0" Style="{StaticResource Card}" Margin="0,0,0,12">
            <StackPanel>
              <Grid>
                <TextBlock Text="IDENTITE GENEREE" Style="{StaticResource Mono}"/>
                <Button Content="Regenerer" Style="{StaticResource Btn}" HorizontalAlignment="Right" Padding="10,4" FontSize="11" Click="Gen_Click"/>
              </Grid>
              <Grid Margin="0,10,0,0">
                <Grid.ColumnDefinitions><ColumnDefinition Width="90"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                <Grid.RowDefinitions><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/></Grid.RowDefinitions>
                <TextBlock Grid.Row="0" Text="UUID" Style="{StaticResource Mono}"/>
                <TextBlock Grid.Row="0" Grid.Column="1" x:Name="TxUuid" FontFamily="Cascadia Mono" FontSize="12"/>
                <TextBlock Grid.Row="1" Text="Disque" Style="{StaticResource Mono}"/>
                <TextBlock Grid.Row="1" Grid.Column="1" x:Name="TxDisk" FontFamily="Cascadia Mono" FontSize="12"/>
                <TextBlock Grid.Row="2" Text="Volume" Style="{StaticResource Mono}"/>
                <TextBlock Grid.Row="2" Grid.Column="1" x:Name="TxVol" FontFamily="Cascadia Mono" FontSize="12"/>
                <TextBlock Grid.Row="3" Text="MAC" Style="{StaticResource Mono}"/>
                <TextBlock Grid.Row="3" Grid.Column="1" x:Name="TxMac" FontFamily="Cascadia Mono" FontSize="12"/>
                <TextBlock Grid.Row="4" Text="GUID" Style="{StaticResource Mono}"/>
                <TextBlock Grid.Row="4" Grid.Column="1" x:Name="TxGuid" FontFamily="Cascadia Mono" FontSize="12"/>
              </Grid>
            </StackPanel>
          </Border>
          <Border Grid.Row="1" Style="{StaticResource Card}" Padding="0">
            <ScrollViewer x:Name="LogScroll" VerticalScrollBarVisibility="Auto" Padding="14">
              <TextBlock x:Name="Log_" FontFamily="Cascadia Mono" FontSize="11.5" TextWrapping="Wrap"/>
            </ScrollViewer>
          </Border>
        </Grid>
      </Grid>
      <Border Grid.Row="2" Background="{StaticResource Panel}" BorderBrush="{StaticResource Line}" BorderThickness="0,1,0,0">
        <Grid Margin="16,0">
          <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
            <Button x:Name="BtnSpoof" Content="SPOOFER + LANCER APEX" Style="{StaticResource Primary}" Click="Spoof_Click"/>
            <Button x:Name="BtnRevert" Content="Restaurer" Style="{StaticResource Btn}" Margin="10,0,0,0" Click="Revert_Click" IsEnabled="False"/>
            <Button x:Name="BtnClean" Content="Cleaner" Style="{StaticResource Btn}" Margin="10,0,0,0" Click="Clean_Click"/>
          </StackPanel>
          <TextBlock Text="v1.0" Style="{StaticResource Mono}" HorizontalAlignment="Right" VerticalAlignment="Center"/>
        </Grid>
      </Border>
    </Grid>
  </Border>
</Window>