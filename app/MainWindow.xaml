<Window x:Class="VnSpoofer.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="v7Zusanc" Height="740" Width="1080" WindowStartupLocation="CenterScreen"
        WindowStyle="None" ResizeMode="CanMinimize" Background="{StaticResource Bg}">
  <Grid Background="{StaticResource BgGrad}">
    <Grid.RowDefinitions>
      <RowDefinition Height="62"/><RowDefinition Height="*"/><RowDefinition Height="70"/>
    </Grid.RowDefinitions>
    <Border Grid.Row="0" MouseLeftButtonDown="Drag">
      <Grid Margin="18,0">
        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
          <Border Width="34" Height="34" CornerRadius="10" Background="{StaticResource AccentGrad}">
            <TextBlock Text="v7" FontWeight="Bold" FontSize="13" Foreground="#08090D"
                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
          </Border>
          <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
            <TextBlock Text="v7Zusanc" FontSize="15" FontWeight="SemiBold"/>
            <TextBlock Text="v7Silever · HWID · multi-jeux" Style="{StaticResource Mono}"/>
          </StackPanel>
          <Border x:Name="PillBg" Background="#171D28" CornerRadius="20" Padding="11,4" Margin="18,0,0,0" VerticalAlignment="Center">
            <StackPanel Orientation="Horizontal">
              <Ellipse x:Name="PillDot" Width="6" Height="6" Fill="#5E6A7C" VerticalAlignment="Center" Margin="0,0,6,0"/>
              <TextBlock x:Name="PillText" Text="INACTIF" FontSize="10.5" FontWeight="SemiBold" Foreground="{StaticResource Muted}"/>
            </StackPanel>
          </Border>
        </StackPanel>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
          <Button Content="-" Style="{StaticResource Ghost}" Padding="14,4" Click="Min_Click" Margin="0,0,6,0"/>
          <Button Content="X" Style="{StaticResource Ghost}" Padding="14,4" Click="Close_Click"/>
        </StackPanel>
      </Grid>
    </Border>
    <Grid Grid.Row="1" Margin="18,4,18,0">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="208"/><ColumnDefinition Width="*"/>
      </Grid.ColumnDefinitions>
      <Border Grid.Column="0" Style="{StaticResource Card}" Padding="9">
        <StackPanel>
          <RadioButton x:Name="NavDash" Style="{StaticResource Nav}" GroupName="nav" IsChecked="True" Click="Nav_Click" Tag="0">
            <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE80F;" Style="{StaticResource Icon}" Margin="0,0,10,0"/><TextBlock Text="Tableau de bord"/></StackPanel>
          </RadioButton>
          <RadioButton x:Name="NavComp" Style="{StaticResource Nav}" GroupName="nav" Click="Nav_Click" Tag="1">
            <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE950;" Style="{StaticResource Icon}" Margin="0,0,10,0"/><TextBlock Text="Composants"/></StackPanel>
          </RadioButton>
          <RadioButton x:Name="NavVerif" Style="{StaticResource Nav}" GroupName="nav" Click="Nav_Click" Tag="2">
            <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE73E;" Style="{StaticResource Icon}" Margin="0,0,10,0"/><TextBlock Text="Verification"/></StackPanel>
          </RadioButton>
          <RadioButton x:Name="NavClean" Style="{StaticResource Nav}" GroupName="nav" Click="Nav_Click" Tag="3">
            <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE74D;" Style="{StaticResource Icon}" Margin="0,0,10,0"/><TextBlock Text="Cleaner"/></StackPanel>
          </RadioButton>
          <RadioButton x:Name="NavLogs" Style="{StaticResource Nav}" GroupName="nav" Click="Nav_Click" Tag="4">
            <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE7C3;" Style="{StaticResource Icon}" Margin="0,0,10,0"/><TextBlock Text="Journal"/></StackPanel>
          </RadioButton>
                <RadioButton x:Name="NavTuto" Style="{StaticResource Nav}" GroupName="nav" Click="Nav_Click" Tag="5">
                    <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE82D;" Style="{StaticResource Icon}" Margin="0,0,10,0"/><TextBlock Text="Tutoriels"/></StackPanel>
                </RadioButton>
          <Border Height="1" Background="{StaticResource Line}" Margin="6,14"/>
          <TextBlock Text="PROVIDER KDU" Style="{StaticResource Mono}" Margin="6,0,0,6"/>
          <ComboBox x:Name="CmbProvider" Style="{StaticResource DarkCombo}" Margin="4,0" SelectedIndex="0">
            <ComboBoxItem Content="Auto (rotatif)"/>
          </ComboBox>
          <CheckBox x:Name="ChkCleanBefore" Content="Cleaner avant spoof" IsChecked="True" Margin="6,10,0,0" FontSize="11"/>
        </StackPanel>
      </Border>
      <Grid Grid.Column="1" Margin="14,0,0,0">
        <Grid x:Name="SecDash" Visibility="Visible">
          <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
          <Border Grid.Row="0" Style="{StaticResource Card}">
            <Grid>
              <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
              <StackPanel>
                <TextBlock x:Name="TxtDashTitle" Text="Aucun spoof actif" FontSize="19" FontWeight="SemiBold"/>
                <TextBlock Text="Spoofer temporaire : rien n'est ecrit sur disque ni dans le BIOS, tout disparait au redemarrage." Style="{StaticResource Mono}" Margin="0,8,0,0" TextWrapping="Wrap"/>
                <Border Background="#141020" BorderBrush="#2A2145" BorderThickness="1" CornerRadius="10" Padding="14" Margin="0,14,0,0">
                  <StackPanel>
                    <TextBlock Text="PROTOCOLE" Style="{StaticResource Mono}" Margin="0,0,0,8"/>
                    <StackPanel Orientation="Horizontal" Margin="0,3"><Border Width="20" Height="20" CornerRadius="10" Background="{StaticResource Accent}"><TextBlock Text="1" FontSize="11" FontWeight="Bold" Foreground="#08090D" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><TextBlock Text="Injecte ton cheat" Margin="10,0,0,0" VerticalAlignment="Center"/></StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,3"><Border Width="20" Height="20" CornerRadius="10" Background="{StaticResource Accent}"><TextBlock Text="2" FontSize="11" FontWeight="Bold" Foreground="#08090D" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><TextBlock Text="Spoof ici, puis controle l'onglet Verification" Margin="10,0,0,0" VerticalAlignment="Center"/></StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,3"><Border Width="20" Height="20" CornerRadius="10" Background="{StaticResource Accent}"><TextBlock Text="3" FontSize="11" FontWeight="Bold" Foreground="#08090D" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><TextBlock Text="Lance le jeu" Margin="10,0,0,0" VerticalAlignment="Center"/></StackPanel>
                  </StackPanel>
                </Border>
                <TextBlock x:Name="TxtCountdown" FontSize="12.5" Foreground="{StaticResource Ok}" Margin="0,12,0,0" TextWrapping="Wrap"/>
              </StackPanel>
              <Border Grid.Column="1" Width="76" Height="76" CornerRadius="38" BorderThickness="2" BorderBrush="#1E2734">
                <TextBlock Text="&#xE72E;" Style="{StaticResource Icon}" FontSize="26" Foreground="#2B3648"
                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
              </Border>
            </Grid>
          </Border>
          <Border Grid.Row="1" Style="{StaticResource Card}" Margin="0,12,0,0">
            <StackPanel>
              <TextBlock Text="IDENTITE EN COURS" Style="{StaticResource Mono}" Margin="0,0,0,12"/>
              <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="150"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                <Grid.RowDefinitions><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/></Grid.RowDefinitions>
                <TextBlock Grid.Row="0" Text="UUID" Style="{StaticResource Mono}"/>
                <TextBlock Grid.Row="0" Grid.Column="1" x:Name="TxtUuid" Style="{StaticResource Cell}" Foreground="{StaticResource Accent2}"/>
                <TextBlock Grid.Row="1" Text="Disque" Style="{StaticResource Mono}"/>
                <TextBlock Grid.Row="1" Grid.Column="1" x:Name="TxtDisk" Style="{StaticResource Cell}" Foreground="{StaticResource Accent2}"/>
                <TextBlock Grid.Row="2" Text="MAC" Style="{StaticResource Mono}"/>
                <TextBlock Grid.Row="2" Grid.Column="1" x:Name="TxtMac" Style="{StaticResource Cell}" Foreground="{StaticResource Accent2}"/>
                <TextBlock Grid.Row="3" Text="MachineGuid" Style="{StaticResource Mono}"/>
                <TextBlock Grid.Row="3" Grid.Column="1" x:Name="TxtGuid" Style="{StaticResource Cell}" Foreground="{StaticResource Accent2}"/>
              </Grid>
            </StackPanel>
          </Border>
        </Grid>
        <ScrollViewer x:Name="SecComp" Visibility="Collapsed" VerticalScrollBarVisibility="Auto">
          <StackPanel>
            <TextBlock Text="COMPOSANTS SPOOFES" Style="{StaticResource Mono}" Margin="2,0,0,10"/>
            <Border Style="{StaticResource Card}">
              <StackPanel>
                <Grid Margin="0,5"><TextBlock Text="SMBIOS : UUID, serial carte mere, BIOS, modele"/><ToggleButton x:Name="SwSmbios" Style="{StaticResource Switch}" HorizontalAlignment="Right" IsChecked="True"/></Grid>
                <Grid Margin="0,5"><TextBlock Text="Serial disque"/><ToggleButton x:Name="SwDisk" Style="{StaticResource Switch}" HorizontalAlignment="Right" IsChecked="True"/></Grid>
                <Grid Margin="0,5"><TextBlock Text="Serial volume"/><ToggleButton x:Name="SwVolume" Style="{StaticResource Switch}" HorizontalAlignment="Right" IsChecked="True"/></Grid>
                <Grid Margin="0,5"><TextBlock Text="Adresse MAC"/><ToggleButton x:Name="SwMac" Style="{StaticResource Switch}" HorizontalAlignment="Right" IsChecked="True"/></Grid>
                <Grid Margin="0,5"><TextBlock Text="MachineGuid"/><ToggleButton x:Name="SwGuid" Style="{StaticResource Switch}" HorizontalAlignment="Right" IsChecked="True"/></Grid>
                <Grid Margin="0,5"><TextBlock Text="Identifiant GPU"/><ToggleButton x:Name="SwGpu" Style="{StaticResource Switch}" HorizontalAlignment="Right" IsChecked="True"/></Grid>
                <Grid Margin="0,5"><TextBlock Text="Adresse IP statique"/><ToggleButton x:Name="SwIp" Style="{StaticResource Switch}" HorizontalAlignment="Right" IsChecked="True"/></Grid>
                <Grid Margin="0,5"><TextBlock Text="EDID ecran"/><ToggleButton x:Name="SwMon" Style="{StaticResource Switch}" HorizontalAlignment="Right" IsChecked="True"/></Grid>
              </StackPanel>
            </Border>
          </StackPanel>
        </ScrollViewer>
        <Grid x:Name="SecVerif" Visibility="Collapsed">
          <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
          <Border Grid.Row="0" Style="{StaticResource Card}" Margin="0,0,0,12">
            <Grid>
              <StackPanel>
                <TextBlock Text="VERIFICATION" Style="{StaticResource Mono}"/>
                <TextBlock x:Name="TxtVerifySum" Text="-" FontSize="15" FontWeight="SemiBold" Margin="0,7,0,0"/>
              </StackPanel>
              <Button Content="Rafraichir" Style="{StaticResource Btn}" HorizontalAlignment="Right" VerticalAlignment="Center" Click="Refresh_Click"/>
            </Grid>
          </Border>
          <Border Grid.Row="1" Style="{StaticResource Card}" Padding="0">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
              <StackPanel Margin="16">
                <Grid Margin="0,0,0,8">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="150"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="34"/>
                  </Grid.ColumnDefinitions>
                  <TextBlock Text="COMPOSANT" Style="{StaticResource Mono}"/>
                  <TextBlock Grid.Column="1" Text="ORIGINE" Style="{StaticResource Mono}"/>
                  <TextBlock Grid.Column="2" Text="ATTENDU" Style="{StaticResource Mono}"/>
                  <TextBlock Grid.Column="3" Text="ACTUEL" Style="{StaticResource Mono}"/>
                </Grid>
                <ItemsControl x:Name="VerifyList">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate>
                      <Border BorderBrush="{StaticResource Line}" BorderThickness="0,1,0,0" Padding="0,7">
                        <Grid>
                          <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="150"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="34"/>
                          </Grid.ColumnDefinitions>
                          <TextBlock Text="{Binding Label}" Style="{StaticResource Cell}" Foreground="{StaticResource Muted}"/>
                          <TextBlock Grid.Column="1" Text="{Binding Original}" Style="{StaticResource Cell}"/>
                          <TextBlock Grid.Column="2" Text="{Binding Expected}" Style="{StaticResource Cell}" Foreground="{StaticResource Accent2}"/>
                          <TextBlock Grid.Column="3" Text="{Binding Actual}" Style="{StaticResource Cell}"/>
                          <TextBlock Grid.Column="4" Text="{Binding Mark}" FontWeight="Bold" HorizontalAlignment="Center" Foreground="{Binding Color}"/>
                        </Grid>
                      </Border>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </StackPanel>
            </ScrollViewer>
          </Border>
        </Grid>
        <ScrollViewer x:Name="SecClean" Visibility="Collapsed" VerticalScrollBarVisibility="Auto">
          <StackPanel>
            <TextBlock Text="NETTOYAGE DES TRACES" Style="{StaticResource Mono}" Margin="2,0,0,10"/>
            <Border Style="{StaticResource Card}">
              <StackPanel>
                <TextBlock TextWrapping="Wrap" Foreground="{StaticResource Muted}" FontSize="12" LineHeight="19" Text="Supprime les caches EAC, les configurations Respawn, les entrees Prefetch, les cles de service EasyAntiCheat, les traces de coquille et purge le cache ARP/DNS."/>
                <Button Content="Lancer le cleaner" Style="{StaticResource Btn}" Margin="0,16,0,0" HorizontalAlignment="Left" Click="Clean_Click"/>
              </StackPanel>
            </Border>
          </StackPanel>
        </ScrollViewer>
            <ScrollViewer x:Name="SecTuto" Visibility="Collapsed" VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <TextBlock Text="TUTORIELS PAR ANTI-TRICHE" Style="{StaticResource Mono}" Margin="2,0,0,10"/>

                    <Border Style="{StaticResource Card}" Margin="0,0,0,10">
                        <StackPanel>
                            <TextBlock Text="CE QUI EST REELLEMENT COUVERT" FontSize="14" FontWeight="SemiBold"/>
                            <TextBlock TextWrapping="Wrap" FontSize="12" LineHeight="19" Foreground="{StaticResource Muted}" Margin="0,8,0,0" Text="SMBIOS (UUID, serie carte mere, serie BIOS, modele) via NtQuerySystemInformation. Serie disque via IOCTL_STORAGE_QUERY_PROPERTY. Serie volume via IRP_MJ_QUERY_VOLUME_INFORMATION. MAC via les OID NDIS. MachineGuid et EDID dans le registre. Identifiant GPU par renommage de la cle Enum. IP par netsh."/>
                            <TextBlock TextWrapping="Wrap" FontSize="12" LineHeight="19" Foreground="{StaticResource Muted}" Margin="0,8,0,0" Text="NON couvert : TPM et son EK, etat Secure Boot, CPUID, SPD des barrettes, numero de serie grave dans la ROM du GPU, et surtout les lectures directes du firmware par un pilote noyau. Un anti-triche qui lit la memoire physique passe au-dessus de nos hooks."/>
                            <TextBlock TextWrapping="Wrap" FontSize="12" LineHeight="19" Foreground="{StaticResource Muted}" Margin="0,8,0,0" Text="Le spoof est temporaire : rien sur disque, tout disparait au redemarrage. Il ne debannit pas un compte, il change l'empreinte pour un nouveau compte."/>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource Card}" Margin="0,0,0,10">
                        <StackPanel>
                            <TextBlock Text="EA JAVELIN" FontSize="15" FontWeight="SemiBold"/>
                            <TextBlock Text="Apex Legends (depuis le 29/09/2026), Battlefield 6, EA SPORTS FC, skate." Style="{StaticResource Mono}" Margin="0,6,0,0" TextWrapping="Wrap"/>
                            <TextBlock TextWrapping="Wrap" FontSize="12" LineHeight="19" Foreground="{StaticResource Muted}" Margin="0,10,0,0" Text="1. Redemarre : un driver deja mappe squatte le nom de device et le nouveau mapping echoue. 2. Ferme les outils noyau (RGB, monitoring, overclock). 3. Applique, puis verifie que les 11 lignes sont OK. 4. Lance Apex. Javelin charge son pilote au demarrage du jeu et peut relire le materiel en direct : le spoof est vu par les couches user-mode, pas garanti contre ses lectures noyau. Apex n'exige pas Secure Boot ; Battlefield 6 et les FC l'exigent."/>
                            <Button Content="Appliquer ce profil" Style="{StaticResource Btn}" HorizontalAlignment="Left" Margin="0,12,0,0" Tag="javelin" Click="Profile_Click"/>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource Card}" Margin="0,0,0,10">
                        <StackPanel>
                            <TextBlock Text="EASY ANTI-CHEAT" FontSize="15" FontWeight="SemiBold"/>
                            <TextBlock Text="Rust, Dead by Daylight, Fortnite, Halo Infinite, Naraka" Style="{StaticResource Mono}" Margin="0,6,0,0" TextWrapping="Wrap"/>
                            <TextBlock TextWrapping="Wrap" FontSize="12" LineHeight="19" Foreground="{StaticResource Muted}" Margin="0,10,0,0" Text="EAC combine user-mode et noyau et hashe un composite : SMBIOS, disque, volume, MAC, MachineGuid. Un seul identifiant inchange suffit a faire correspondre l'empreinte, donc tous les composants doivent etre actifs. Redemarre avant, applique, verifie, puis lance le jeu. Ferme les overlays et les autres spoofer."/>
                            <Button Content="Appliquer ce profil" Style="{StaticResource Btn}" HorizontalAlignment="Left" Margin="0,12,0,0" Tag="eac" Click="Profile_Click"/>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource Card}" Margin="0,0,0,10">
                        <StackPanel>
                            <TextBlock Text="BATTLEYE" FontSize="15" FontWeight="SemiBold"/>
                            <TextBlock Text="Rainbow Six Siege, PUBG, Escape from Tarkov, DayZ, Arma" Style="{StaticResource Mono}" Margin="0,6,0,0" TextWrapping="Wrap"/>
                            <TextBlock TextWrapping="Wrap" FontSize="12" LineHeight="19" Foreground="{StaticResource Muted}" Margin="0,10,0,0" Text="BattlEye inspecte en plus les handles ouverts et la liste des pilotes charges. Un driver mappe manuellement est visible dans cette liste : c'est la limite principale ici. Applique tous les composants et evite de garder d'autres outils noyau ouverts pendant la session."/>
                            <Button Content="Appliquer ce profil" Style="{StaticResource Btn}" HorizontalAlignment="Left" Margin="0,12,0,0" Tag="battleye" Click="Profile_Click"/>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource Card}" Margin="0,0,0,10">
                        <StackPanel>
                            <TextBlock Text="VANGUARD" FontSize="15" FontWeight="SemiBold"/>
                            <TextBlock Text="Valorant, League of Legends" Style="{StaticResource Mono}" Margin="0,6,0,0" TextWrapping="Wrap"/>
                            <TextBlock TextWrapping="Wrap" FontSize="12" LineHeight="19" Foreground="{StaticResource Muted}" Margin="0,10,0,0" Text="vgk.sys se charge au demarrage de Windows, donc avant nous, et peut avoir lu le materiel deja. C'est l'anti-triche le plus hostile au mapping manuel. Traite le spoof comme partiel : compte sur les composants registre et disque, pas sur le SMBIOS. Redemarre entre chaque session. Vanguard exige Secure Boot et TPM 2.0."/>
                            <Button Content="Appliquer ce profil" Style="{StaticResource Btn}" HorizontalAlignment="Left" Margin="0,12,0,0" Tag="vanguard" Click="Profile_Click"/>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource Card}" Margin="0,0,0,10">
                        <StackPanel>
                            <TextBlock Text="RICOCHET" FontSize="15" FontWeight="SemiBold"/>
                            <TextBlock Text="Call of Duty Modern Warfare, Warzone" Style="{StaticResource Mono}" Margin="0,6,0,0" TextWrapping="Wrap"/>
                            <TextBlock TextWrapping="Wrap" FontSize="12" LineHeight="19" Foreground="{StaticResource Muted}" Margin="0,10,0,0" Text="Ricochet relit le materiel cote noyau et s'appuie sur TPM et Secure Boot. Meme limite que Vanguard : le SMBIOS est le maillon faible. Applique, verifie, lance le jeu, et ne redemarre pas pendant la session."/>
                            <Button Content="Appliquer ce profil" Style="{StaticResource Btn}" HorizontalAlignment="Left" Margin="0,12,0,0" Tag="ricochet" Click="Profile_Click"/>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Text="SANS ANTI-TRICHE" FontSize="15" FontWeight="SemiBold"/>
                            <TextBlock Text="Jeux solo, Steam hors ligne, emulateurs" Style="{StaticResource Mono}" Margin="0,6,0,0" TextWrapping="Wrap"/>
                            <TextBlock TextWrapping="Wrap" FontSize="12" LineHeight="19" Foreground="{StaticResource Muted}" Margin="0,10,0,0" Text="Aucun risque de detection. Tous les composants peuvent rester actifs, le spoof est purement cosmetique."/>
                            <Button Content="Appliquer ce profil" Style="{StaticResource Btn}" HorizontalAlignment="Left" Margin="0,12,0,0" Tag="solo" Click="Profile_Click"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>
        <Border x:Name="SecLogs" Visibility="Collapsed" Style="{StaticResource Card}" Padding="0">
          <ScrollViewer x:Name="LogScroll" VerticalScrollBarVisibility="Auto" Padding="16">
            <TextBlock x:Name="TxtLog" FontFamily="Cascadia Mono" FontSize="11.5" TextWrapping="Wrap"/>
          </ScrollViewer>
        </Border>
      </Grid>
    </Grid>
    <Border Grid.Row="2" BorderBrush="{StaticResource Line}" BorderThickness="0,1,0,0">
      <Grid Margin="18,0">
        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
          <Button x:Name="BtnSpoof" Content="SPOOFER" Style="{StaticResource Primary}" Click="Spoof_Click"/>
          <Button x:Name="BtnRevert" Content="Restaurer" Style="{StaticResource Btn}" Margin="12,0,0,0" Click="Revert_Click" IsEnabled="False"/>
          <Button x:Name="BtnReboot" Content="Redemarrer" Style="{StaticResource Ghost}" Margin="12,0,0,0" Click="Reboot_Click"/>
          <Button x:Name="BtnCancelCd" Content="Annuler le reboot" Style="{StaticResource Ghost}" Margin="12,0,0,0" Visibility="Collapsed" Click="CancelCd_Click"/>
        </StackPanel>
        <TextBlock Text="v2.2" Style="{StaticResource Mono}" HorizontalAlignment="Right" VerticalAlignment="Center"/>
      </Grid>
    </Border>
  </Grid>
</Window>
