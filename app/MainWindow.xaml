<Window x:Class="VnSpoofer.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="VnSpoofer" Height="720" Width="1060" WindowStartupLocation="CenterScreen"
        WindowStyle="None" ResizeMode="CanMinimize" Background="{StaticResource Bg}">
  <Border BorderBrush="{StaticResource Line}" BorderThickness="1">
    <Grid>
      <Grid.RowDefinitions>
        <RowDefinition Height="54"/><RowDefinition Height="*"/><RowDefinition Height="66"/>
      </Grid.RowDefinitions>
      <Border Grid.Row="0" Background="{StaticResource Panel}" MouseLeftButtonDown="Drag">
        <Grid Margin="18,0">
          <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
            <TextBlock Text="VN" FontSize="16" FontWeight="Bold" Foreground="{StaticResource Accent}"/>
            <TextBlock Text="SPOOFER" FontSize="16" FontWeight="Bold" Margin="4,0,14,0"/>
            <Border x:Name="PillBg" Background="{StaticResource Panel2}" CornerRadius="20" Padding="10,4" VerticalAlignment="Center">
              <TextBlock x:Name="PillText" Text="INACTIF" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource Muted}"/>
            </Border>
          </StackPanel>
          <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
            <Button Content="-" Style="{StaticResource Btn}" Padding="14,4" Click="Min_Click" Margin="0,0,6,0"/>
            <Button Content="X" Style="{StaticResource Btn}" Padding="14,4" Click="Close_Click"/>
          </StackPanel>
        </Grid>
      </Border>
      <Grid Grid.Row="1" Margin="16">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="196"/><ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <Border Grid.Column="0" Style="{StaticResource Card}" Padding="8">
          <StackPanel>
            <RadioButton x:Name="NavDash" Style="{StaticResource Nav}" Content="Tableau de bord" GroupName="nav" IsChecked="True" Click="Nav_Click" Tag="0"/>
            <RadioButton x:Name="NavComp" Style="{StaticResource Nav}" Content="Composants" GroupName="nav" Click="Nav_Click" Tag="1"/>
            <RadioButton x:Name="NavVerif" Style="{StaticResource Nav}" Content="Verification" GroupName="nav" Click="Nav_Click" Tag="2"/>
            <RadioButton x:Name="NavClean" Style="{StaticResource Nav}" Content="Cleaner" GroupName="nav" Click="Nav_Click" Tag="3"/>
            <RadioButton x:Name="NavLogs" Style="{StaticResource Nav}" Content="Journal" GroupName="nav" Click="Nav_Click" Tag="4"/>
            <Separator Margin="6,12" Background="{StaticResource Line}"/>
            <TextBlock Text="PROVIDER KDU" Style="{StaticResource Mono}" Margin="6,0,0,6"/>
            <ComboBox x:Name="CmbProvider" Margin="4,0" SelectedIndex="0">
              <ComboBoxItem Content="Auto (rotatif)"/>
            </ComboBox>
            <CheckBox x:Name="ChkCleanBefore" Content="Cleaner avant spoof" IsChecked="True" Margin="6,10,0,0" FontSize="11.5"/>
            <CheckBox x:Name="ChkLaunch" Content="Lancer Apex" Margin="6,0,0,0" FontSize="11.5"/>
          </StackPanel>
        </Border>
        <Grid Grid.Column="1" Margin="14,0,0,0">
          <Grid x:Name="SecDash" Visibility="Visible">
            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
            <Border Grid.Row="0" Style="{StaticResource Card}">
              <StackPanel>
                <TextBlock x:Name="TxtDashTitle" Text="Aucun spoof actif" FontSize="17" FontWeight="SemiBold"/>
                <TextBlock Text="Genere une identite puis applique-la. Le PC redemarre et la verification se fait automatiquement." Style="{StaticResource Mono}" Margin="0,6,0,0" TextWrapping="Wrap"/>
                <TextBlock x:Name="TxtCountdown" FontSize="13" Foreground="{StaticResource Warn}" Margin="0,10,0,0"/>
              </StackPanel>
            </Border>
            <Border Grid.Row="1" Style="{StaticResource Card}" Margin="0,12,0,0">
              <StackPanel>
                <TextBlock Text="IDENTITE EN COURS" Style="{StaticResource Mono}" Margin="0,0,0,10"/>
                <Grid>
                  <Grid.ColumnDefinitions><ColumnDefinition Width="150"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                  <Grid.RowDefinitions><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/></Grid.RowDefinitions>
                  <TextBlock Grid.Row="0" Text="UUID" Style="{StaticResource Mono}"/>
                  <TextBlock Grid.Row="0" Grid.Column="1" x:Name="TxtUuid" Style="{StaticResource Cell}" Foreground="{StaticResource Text}"/>
                  <TextBlock Grid.Row="1" Text="Disque" Style="{StaticResource Mono}"/>
                  <TextBlock Grid.Row="1" Grid.Column="1" x:Name="TxtDisk" Style="{StaticResource Cell}" Foreground="{StaticResource Text}"/>
                  <TextBlock Grid.Row="2" Text="MAC" Style="{StaticResource Mono}"/>
                  <TextBlock Grid.Row="2" Grid.Column="1" x:Name="TxtMac" Style="{StaticResource Cell}" Foreground="{StaticResource Text}"/>
                  <TextBlock Grid.Row="3" Text="MachineGuid" Style="{StaticResource Mono}"/>
                  <TextBlock Grid.Row="3" Grid.Column="1" x:Name="TxtGuid" Style="{StaticResource Cell}" Foreground="{StaticResource Text}"/>
                </Grid>
              </StackPanel>
            </Border>
          </Grid>
          <ScrollViewer x:Name="SecComp" Visibility="Collapsed" VerticalScrollBarVisibility="Auto">
            <StackPanel>
              <TextBlock Text="COMPOSANTS SPOOFES" Style="{StaticResource Mono}" Margin="0,0,0,8"/>
              <Border Style="{StaticResource Card}">
                <StackPanel>
                  <Grid Margin="0,4"><TextBlock Text="SMBIOS : UUID, serial carte mere, BIOS, modele"/><ToggleButton x:Name="SwSmbios" Style="{StaticResource Switch}" HorizontalAlignment="Right" IsChecked="True"/></Grid>
                  <Grid Margin="0,4"><TextBlock Text="Serial disque"/><ToggleButton x:Name="SwDisk" Style="{StaticResource Switch}" HorizontalAlignment="Right" IsChecked="True"/></Grid>
                  <Grid Margin="0,4"><TextBlock Text="Serial volume"/><ToggleButton x:Name="SwVolume" Style="{StaticResource Switch}" HorizontalAlignment="Right" IsChecked="True"/></Grid>
                  <Grid Margin="0,4"><TextBlock Text="Adresse MAC"/><ToggleButton x:Name="SwMac" Style="{StaticResource Switch}" HorizontalAlignment="Right" IsChecked="True"/></Grid>
                  <Grid Margin="0,4"><TextBlock Text="MachineGuid"/><ToggleButton x:Name="SwGuid" Style="{StaticResource Switch}" HorizontalAlignment="Right" IsChecked="True"/></Grid>
                  <Grid Margin="0,4"><TextBlock Text="Identifiant GPU"/><ToggleButton x:Name="SwGpu" Style="{StaticResource Switch}" HorizontalAlignment="Right" IsChecked="True"/></Grid>
                  <Grid Margin="0,4"><TextBlock Text="Adresse IP statique"/><ToggleButton x:Name="SwIp" Style="{StaticResource Switch}" HorizontalAlignment="Right" IsChecked="True"/></Grid>
                  <Grid Margin="0,4"><TextBlock Text="EDID ecran"/><ToggleButton x:Name="SwMon" Style="{StaticResource Switch}" HorizontalAlignment="Right" IsChecked="True"/></Grid>
                </StackPanel>
              </Border>
            </StackPanel>
          </ScrollViewer>
          <Grid x:Name="SecVerif" Visibility="Collapsed">
            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
            <Border Grid.Row="0" Style="{StaticResource Card}" Margin="0,0,0,10">
              <Grid>
                <StackPanel>
                  <TextBlock Text="VERIFICATION" Style="{StaticResource Mono}"/>
                  <TextBlock x:Name="TxtVerifySum" Text="-" FontSize="14" FontWeight="SemiBold" Margin="0,6,0,0"/>
                </StackPanel>
                <Button Content="Rafraichir" Style="{StaticResource Btn}" HorizontalAlignment="Right" VerticalAlignment="Center" Click="Refresh_Click"/>
              </Grid>
            </Border>
            <Border Grid.Row="1" Style="{StaticResource Card}" Padding="0">
              <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="14">
                  <Grid Margin="0,0,0,6">
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="150"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="34"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="COMPOSANT" Style="{StaticResource Mono}"/>
                    <TextBlock Grid.Column="1" Text="ORIGINE" Style="{StaticResource Mono}"/>
                    <TextBlock Grid.Column="2" Text="ATTENDU" Style="{StaticResource Mono}"/>
                    <TextBlock Grid.Column="3" Text="ACTUEL" Style="{StaticResource Mono}"/>
                  </Grid>
                  <ItemsControl x:Name="VerifyList">
                    <ItemsControl.ItemTemplate>
                      <DataTemplate>
                        <Border BorderBrush="{StaticResource Line}" BorderThickness="0,1,0,0" Padding="0,6">
                          <Grid>
                            <Grid.ColumnDefinitions>
                              <ColumnDefinition Width="150"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="34"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="{Binding Label}" Style="{StaticResource Cell}" Foreground="{StaticResource Muted}"/>
                            <TextBlock Grid.Column="1" Text="{Binding Original}" Style="{StaticResource Cell}"/>
                            <TextBlock Grid.Column="2" Text="{Binding Expected}" Style="{StaticResource Cell}"/>
                            <TextBlock Grid.Column="3" Text="{Binding Actual}" Style="{StaticResource Cell}"/>
                            <TextBlock Grid.Column="4" Text="{Binding Mark}" FontWeight="Bold" HorizontalAlignment="Center" Foreground="{Binding Color}"/>
                          </Grid>
                        </Border>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                </StackPanel>
              </ScrollViewer>
            </Border>
          </Grid>
          <ScrollViewer x:Name="SecClean" Visibility="Collapsed" VerticalScrollBarVisibility="Auto">
            <StackPanel>
              <TextBlock Text="NETTOYAGE DES TRACES" Style="{StaticResource Mono}" Margin="0,0,0,8"/>
              <Border Style="{StaticResource Card}">
                <StackPanel>
                  <TextBlock TextWrapping="Wrap" Foreground="{StaticResource Muted}" FontSize="12" Text="Supprime les caches EAC, les configurations Respawn, les entrees Prefetch, les cles de service EasyAntiCheat, les traces de coquille et purge le cache ARP/DNS."/>
                  <Button Content="Lancer le cleaner" Style="{StaticResource Btn}" Margin="0,14,0,0" HorizontalAlignment="Left" Click="Clean_Click"/>
                </StackPanel>
              </Border>
            </StackPanel>
          </ScrollViewer>
          <Border x:Name="SecLogs" Visibility="Collapsed" Style="{StaticResource Card}" Padding="0">
            <ScrollViewer x:Name="LogScroll" VerticalScrollBarVisibility="Auto" Padding="14">
              <TextBlock x:Name="TxtLog" FontFamily="Cascadia Mono" FontSize="11.5" TextWrapping="Wrap"/>
            </ScrollViewer>
          </Border>
        </Grid>
      </Grid>
      <Border Grid.Row="2" Background="{StaticResource Panel}" BorderBrush="{StaticResource Line}" BorderThickness="0,1,0,0">
        <Grid Margin="16,0">
          <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
            <Button x:Name="BtnSpoof" Content="SPOOFER" Style="{StaticResource Primary}" Click="Spoof_Click"/>
            <Button x:Name="BtnRevert" Content="Restaurer" Style="{StaticResource Btn}" Margin="10,0,0,0" Click="Revert_Click" IsEnabled="False"/>
            <Button x:Name="BtnReboot" Content="Redemarrer" Style="{StaticResource Btn}" Margin="10,0,0,0" Click="Reboot_Click"/>
            <Button x:Name="BtnCancelCd" Content="Annuler le reboot" Style="{StaticResource Btn}" Margin="10,0,0,0" Visibility="Collapsed" Click="CancelCd_Click"/>
          </StackPanel>
          <TextBlock Text="v2.0" Style="{StaticResource Mono}" HorizontalAlignment="Right" VerticalAlignment="Center"/>
        </Grid>
      </Border>
    </Grid>
  </Border>
</Window>
