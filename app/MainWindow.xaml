<Window x:Class="VnSpoofer.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="v7Zusanc" Height="740" Width="1080" WindowStartupLocation="CenterScreen"
        Loaded="Window_Loaded" WindowStyle="None" ResizeMode="CanMinimize" Background="{StaticResource Bg}">
  <Window.Resources>
    <Style x:Key="ProfCard" TargetType="Button">
      <Setter Property="Background" Value="#12161E"/>
      <Setter Property="BorderBrush" Value="#232B38"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="Foreground" Value="#E7ECF3"/>
      <Setter Property="Padding" Value="12,7"/>
      <Setter Property="Margin" Value="0,0,7,7"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="FontSize" Value="11.5"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="9" Padding="{TemplateBinding Padding}">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
      <Style.Triggers>
        <Trigger Property="IsMouseOver" Value="True">
          <Setter Property="BorderBrush" Value="{StaticResource Accent}"/>
          <Setter Property="Background" Value="#1A2130"/>
        </Trigger>
      </Style.Triggers>
    </Style>
    <Style x:Key="ThinBar" TargetType="ProgressBar">
      <Setter Property="Height" Value="4"/>
      <Setter Property="Background" Value="#1B2230"/>
      <Setter Property="Foreground" Value="{StaticResource Accent}"/>
      <Setter Property="BorderThickness" Value="0"/>
    </Style>
  </Window.Resources>
  <Grid Background="{StaticResource BgGrad}">
    <Grid.RowDefinitions>
      <RowDefinition Height="62"/><RowDefinition Height="*"/><RowDefinition Height="70"/>
    </Grid.RowDefinitions>
    <Border Grid.Row="0" MouseLeftButtonDown="Drag">
      <Grid Margin="18,0">
        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
          <Border Width="34" Height="34" CornerRadius="10" Background="{StaticResource AccentGrad}">
            <TextBlock Text="v7" FontWeight="Bold" FontSize="13" Foreground="#08090D"
                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
          </Border>
          <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
            <TextBlock Text="v7Zusanc" FontSize="15" FontWeight="SemiBold"/>
            <TextBlock Text="v7Silever - HWID - multi-jeux" Style="{StaticResource Mono}"/>
          </StackPanel>
          <Border x:Name="PillBg" Background="#171D28" CornerRadius="20" Padding="11,4" Margin="18,0,0,0" VerticalAlignment="Center">
            <StackPanel Orientation="Horizontal">
              <Ellipse x:Name="PillDot" Width="6" Height="6" Fill="#5E6A7C" VerticalAlignment="Center" Margin="0,0,6,0"/>
              <TextBlock x:Name="PillText" Text="INACTIF" FontSize="10.5" FontWeight="SemiBold" Foreground="{StaticResource Muted}"/>
            </StackPanel>
          </Border>
          <Border Background="#1B2233" BorderBrush="#2A3446" BorderThickness="1" CornerRadius="6" Padding="7,3" Margin="8,0,0,0" VerticalAlignment="Center">
            <TextBlock Text="TEMP" FontSize="9.5" FontWeight="Bold" Foreground="{StaticResource Accent2}"/>
          </Border>
        </StackPanel>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
          <Button Content="-" Style="{StaticResource Ghost}" Padding="14,4" Click="Min_Click" Margin="0,0,6,0"/>
          <Button Content="X" Style="{StaticResource Ghost}" Padding="14,4" Click="Close_Click"/>
        </StackPanel>
      </Grid>
    </Border>
    <Grid Grid.Row="1" Margin="18,4,18,0">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="208"/><ColumnDefinition Width="*"/>
      </Grid.ColumnDefinitions>
      <Border Grid.Column="0" Style="{StaticResource Card}" Padding="9">
        <StackPanel>
          <RadioButton x:Name="NavDash" Style="{StaticResource Nav}" GroupName="nav" IsChecked="True" Click="Nav_Click" Tag="0">
            <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE80F;" Style="{StaticResource Icon}" Margin="0,0,10,0"/><TextBlock Text="Tableau de bord"/></StackPanel>
          </RadioButton>
          <RadioButton x:Name="NavComp" Style="{StaticResource Nav}" GroupName="nav" Click="Nav_Click" Tag="1">
            <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE950;" Style="{StaticResource Icon}" Margin="0,0,10,0"/><TextBlock Text="Composants"/></StackPanel>
          </RadioButton>
          <RadioButton x:Name="NavVerif" Style="{StaticResource Nav}" GroupName="nav" Click="Nav_Click" Tag="2">
            <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE73E;" Style="{StaticResource Icon}" Margin="0,0,10,0"/><TextBlock Text="Verification"/></StackPanel>
          </RadioButton>
          <RadioButton x:Name="NavClean" Style="{StaticResource Nav}" GroupName="nav" Click="Nav_Click" Tag="3">
            <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE74D;" Style="{StaticResource Icon}" Margin="0,0,10,0"/><TextBlock Text="Cleaner"/></StackPanel>
          </RadioButton>
          <RadioButton x:Name="NavLogs" Style="{StaticResource Nav}" GroupName="nav" Click="Nav_Click" Tag="4">
            <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE7C3;" Style="{StaticResource Icon}" Margin="0,0,10,0"/><TextBlock Text="Journal"/></StackPanel>
          </RadioButton>
          <RadioButton x:Name="NavTuto" Style="{StaticResource Nav}" GroupName="nav" Click="Nav_Click" Tag="5">
            <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE82D;" Style="{StaticResource Icon}" Margin="0,0,10,0"/><TextBlock Text="Tutoriels"/></StackPanel>
          </RadioButton>
          <Border Height="1" Background="{StaticResource Line}" Margin="6,14"/>
          <TextBlock Text="PROVIDER KDU" Style="{StaticResource Mono}" Margin="6,0,0,6"/>
          <ComboBox x:Name="CmbProvider" Style="{StaticResource DarkCombo}" Margin="4,0" SelectedIndex="0">
            <ComboBoxItem Content="Auto (rotatif)"/>
          </ComboBox>
          <CheckBox x:Name="ChkCleanBefore" Content="Cleaner avant spoof" IsChecked="True" Margin="6,10,0,0" FontSize="11"/>
        </StackPanel>
      </Border>
      <Grid Grid.Column="1" Margin="14,0,0,0">
        <Grid x:Name="SecDash" Visibility="Visible">
          <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
          <Border Grid.Row="0" Style="{StaticResource Card}">
            <Grid>
              <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
              <StackPanel>
                <TextBlock x:Name="TxtDashTitle" Text="Aucun spoof actif" FontSize="19" FontWeight="SemiBold"/>
                <TextBlock Text="Spoofer temporaire : rien n'est ecrit sur disque ni dans le BIOS, tout disparait au redemarrage." Style="{StaticResource Mono}" Margin="0,8,0,0" TextWrapping="Wrap"/>
                <TextBlock Text="PROFIL" Style="{StaticResource Mono}" Margin="0,14,0,7"/>
                <WrapPanel>
                  <Button x:Name="ProfAll" Content="Tout" Style="{StaticResource ProfCard}" Tag="all" Click="Profile_Click"/>
                  <Button x:Name="ProfJav" Content="Javelin" Style="{StaticResource ProfCard}" Tag="javelin" Click="Profile_Click"/>
                  <Button x:Name="ProfEac" Content="EAC" Style="{StaticResource ProfCard}" Tag="eac" Click="Profile_Click"/>
                  <Button x:Name="ProfBe" Content="BattlEye" Style="{StaticResource ProfCard}" Tag="battleye" Click="Profile_Click"/>
                  <Button x:Name="ProfVg" Content="Vanguard" Style="{StaticResource ProfCard}" Tag="vanguard" Click="Profile_Click"/>
                  <Button x:Name="ProfRc" Content="Ricochet" Style="{StaticResource ProfCard}" Tag="ricochet" Click="Profile_Click"/>
                  <Button x:Name="ProfSolo" Content="Solo" Style="{StaticResource ProfCard}" Tag="solo" Click="Profile_Click"/>
                </WrapPanel>
                <TextBlock x:Name="TxtProfDesc" Style="{StaticResource Mono}" TextWrapping="Wrap" Margin="0,3,0,0"/>
                <TextBlock x:Name="TxtCountdown" FontSize="12.5" Foreground="{StaticResource Ok}" Margin="0,12,0,0" TextWrapping="Wrap"/>
              </StackPanel>
              <Border Grid.Column="1" Width="76" Height="76" CornerRadius="38" BorderThickness="2" BorderBrush="#1E2734">
                <TextBlock Text="&#xE72E;" Style="{StaticResource Icon}" FontSize="26" Foreground="#2B3648"
                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
              </Border>
            </Grid>
          </Border>
          <Border Grid.Row="1" Style="{StaticResource Card}" Margin="0,12,0,0">
            <StackPanel>
              <TextBlock Text="IDENTITE EN COURS" Style="{StaticResource Mono}" Margin="0,0,0,12"/>
              <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="150"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                <Grid.RowDefinitions><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/></Grid.RowDefinitions>
                <TextBlock Grid.Row="0" Text="UUID" Style="{StaticResource Mono}"/>
                <TextBlock Grid.Row="0" Grid.Column="1" x:Name="TxtUuid" Style="{StaticResource Cell}" Foreground="{StaticResource Accent2}"/>
                <TextBlock Grid.Row="1" Text="Disque" Style="{StaticResource Mono}"/>
                <TextBlock Grid.Row="1" Grid.Column="1" x:Name="TxtDisk" Style="{StaticResource Cell}" Foreground="{StaticResource Accent2}"/>
                <TextBlock Grid.Row="2" Text="MAC" Style="{StaticResource Mono}"/>
                <TextBlock Grid.Row="2" Grid.Column="1" x:Name="TxtMac" Style="{StaticResource Cell}" Foreground="{StaticResource Accent2}"/>
                <TextBlock Grid.Row="3" Text="MachineGuid" Style="{StaticResource Mono}"/>
                <TextBlock Grid.Row="3" Grid.Column="1" x:Name="TxtGuid" Style="{StaticResource Cell}" Foreground="{StaticResource Accent2}"/>
              </Grid>
            </StackPanel>
          </Border>
        </Grid>
        <ScrollViewer x:Name="SecComp" Visibility="Collapsed" VerticalScrollBarVisibility="Auto">
          <StackPanel>
            <TextBlock Text="COMPOSANTS SPOOFES" Style="{StaticResource Mono}" Margin="2,0,0,10"/>
            <Border Style="{StaticResource Card}">
              <StackPanel>
                <Grid Margin="0,5"><TextBlock Text="SMBIOS : UUID, serial carte mere, BIOS, modele"/><ToggleButton x:Name="SwSmbios" Style="{StaticResource Switch}" HorizontalAlignment="Right" IsChecked="True"/></Grid>
                <Grid Margin="0,5"><TextBlock Text="Serial disque"/><ToggleButton x:Name="SwDisk" Style="{StaticResource Switch}" HorizontalAlignment="Right" IsChecked="True"/></Grid>
                <Grid Margin="0,5"><TextBlock Text="Serial volume"/><ToggleButton x:Name="SwVolume" Style="{StaticResource Switch}" HorizontalAlignment="Right" IsChecked="True"/></Grid>
                <Grid Margin="0,5"><TextBlock Text="Adresse MAC"/><ToggleButton x:Name="SwMac" Style="{StaticResource Switch}" HorizontalAlignment="Right" IsChecked="True"/></Grid>
                <Grid Margin="0,5"><TextBlock Text="MachineGuid"/><ToggleButton x:Name="SwGuid" Style="{StaticResource Switch}" HorizontalAlignment="Right" IsChecked="True"/></Grid>
                <Grid Margin="0,5"><TextBlock Text="Identifiant GPU"/><ToggleButton x:Name="SwGpu" Style="{StaticResource Switch}" HorizontalAlignment="Right" IsChecked="True"/></Grid>
                <Grid Margin="0,5"><TextBlock Text="Adresse IP"/><ToggleButton x:Name="SwIp" Style="{StaticResource Switch}" HorizontalAlignment="Right" IsChecked="True"/></Grid>
                <Grid Margin="0,5"><TextBlock Text="EDID ecran"/><ToggleButton x:Name="SwMon" Style="{StaticResource Switch}" HorizontalAlignment="Right" IsChecked="True"/></Grid>
              </StackPanel>
            </Border>
            <TextBlock TextWrapping="Wrap" FontSize="11.5" Foreground="{StaticResource Muted}" Margin="2,12,0,0" Text="Les profils reglent ces interrupteurs. L'IP et l'EDID sont desactives par defaut sur les profils anti-triche : l'IP depend du DHCP et peut casser le reseau, l'EDID n'est lu par presque aucun jeu."/>
          </StackPanel>
        </ScrollViewer>
        <Grid x:Name="SecVerif" Visibility="Collapsed">
          <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
          <Border Grid.Row="0" Style="{StaticResource Card}" Margin="0,0,0,12">
            <Grid>
              <StackPanel>
                <TextBlock Text="VERIFICATION" Style="{StaticResource Mono}"/>
                <TextBlock x:Name="TxtVerifySum" Text="-" FontSize="15" FontWeight="SemiBold" Margin="0,7,0,0"/>
              </StackPanel>
              <Button Content="Rafraichir" Style="{StaticResource Btn}" HorizontalAlignment="Right" VerticalAlignment="Center" Click="Refresh_Click"/>
            </Grid>
          </Border>
          <Border Grid.Row="1" Style="{StaticResource Card}" Padding="0">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
              <StackPanel Margin="16">
                <Grid Margin="0,0,0,8">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="150"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="34"/>
                  </Grid.ColumnDefinitions>
                  <TextBlock Text="COMPOSANT" Style="{StaticResource Mono}"/>
                  <TextBlock Grid.Column="1" Text="ORIGINE" Style="{StaticResource Mono}"/>
                  <TextBlock Grid.Column="2" Text="ATTENDU" Style="{StaticResource Mono}"/>
                  <TextBlock Grid.Column="3" Text="ACTUEL" Style="{StaticResource Mono}"/>
                </Grid>
                <ItemsControl x:Name="VerifyList">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate>
                      <Border BorderBrush="{StaticResource Line}" BorderThickness="0,1,0,0" Padding="0,7">
                        <Grid>
                          <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="150"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="34"/>
                          </Grid.ColumnDefinitions>
                          <TextBlock Text="{Binding Label}" Style="{StaticResource Cell}" Foreground="{StaticResource Muted}"/>
                          <TextBlock Grid.Column="1" Text="{Binding Original}" Style="{StaticResource Cell}"/>
                          <TextBlock Grid.Column="2" Text="{Binding Expected}" Style="{StaticResource Cell}" Foreground="{StaticResource Accent2}"/>
                          <TextBlock Grid.Column="3" Text="{Binding Actual}" Style="{StaticResource Cell}"/>
                          <TextBlock Grid.Column="4" Text="{Binding Mark}" FontWeight="Bold" HorizontalAlignment="Center" Foreground="{Binding Color}"/>
                        </Grid>
                      </Border>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </StackPanel>
            </ScrollViewer>
          </Border>
        </Grid>
        <ScrollViewer x:Name="SecClean" Visibility="Collapsed" VerticalScrollBarVisibility="Auto">
          <StackPanel>
            <TextBlock Text="NETTOYAGE DES TRACES" Style="{StaticResource Mono}" Margin="2,0,0,10"/>
            <Border Style="{StaticResource Card}">
              <StackPanel>
                <TextBlock TextWrapping="Wrap" Foreground="{StaticResource Muted}" FontSize="12" LineHeight="19" Text="Supprime les caches EAC, les configurations Respawn, les entrees Prefetch, les cles de service EasyAntiCheat, les traces de coquille et purge le cache ARP/DNS."/>
                <Button Content="Lancer le cleaner" Style="{StaticResource Btn}" Margin="0,16,0,0" HorizontalAlignment="Left" Click="Clean_Click"/>
              </StackPanel>
            </Border>
          </StackPanel>
        </ScrollViewer>
        <ScrollViewer x:Name="SecTuto" Visibility="Collapsed" VerticalScrollBarVisibility="Auto">
          <StackPanel>
            <TextBlock Text="TUTORIELS PAR ANTI-TRICHE" Style="{StaticResource Mono}" Margin="2,0,0,10"/>
            <Border Style="{StaticResource Card}" Margin="0,0,0,10" BorderBrush="{StaticResource Accent}" BorderThickness="1">
              <StackPanel>
                <TextBlock Text="COMMENCER ICI - C'EST QUOI UN TEMP SPOOFER" FontSize="14" FontWeight="SemiBold"/>
                <TextBlock TextWrapping="Wrap" FontSize="12" LineHeight="19" Foreground="{StaticResource Muted}" Margin="0,8,0,0" Text="Un temp spoofer change l'empreinte materielle de ta machine pour la duree d'une session, sans rien installer ni ecrire dans le BIOS. Le pilote est mappe en memoire, les identifiants sont remplaces a la volee. Au redemarrage, tout disparait et la machine reprend son empreinte d'origine. Rien n'est permanent, rien n'est irreversible."/>
                <TextBlock TextWrapping="Wrap" FontSize="12" LineHeight="19" Foreground="{StaticResource Muted}" Margin="0,8,0,0" Text="A quoi ca sert : repartir avec une empreinte neuve sur un jeu, sans acheter de materiel ni reinstaller Windows. A quoi ca ne sert pas : debannir un compte deja marque, contourner le TPM ou le CPUID."/>
                <TextBlock Text="DEROULEMENT, DANS L'ORDRE" Style="{StaticResource Mono}" Margin="0,14,0,6"/>
                <TextBlock TextWrapping="Wrap" FontSize="12" LineHeight="19" Foreground="{StaticResource Muted}" Text="1. Redemarre le PC. Obligatoire : un pilote deja mappe squatte le nom du device et le nouveau mapping echoue. 2. Ouvre l'app en administrateur. 3. Ferme les outils noyau : RGB, monitoring, overclock, autre spoofer. 4. Choisis le profil du jeu vise. 5. Clique APPLIQUER et laisse aller jusqu'au bout. 6. Va dans Verification : les 11 lignes doivent etre vertes. Une seule ligne rouge et l'empreinte n'est pas neuve, donc tu redemarres et tu recommences. 7. Lance le jeu. 8. Ne redemarre pas pendant la session."/>
                <TextBlock Text="ERREURS CLASSIQUES" Style="{StaticResource Mono}" Margin="0,14,0,6"/>
                <TextBlock TextWrapping="Wrap" FontSize="12" LineHeight="19" Foreground="{StaticResource Muted}" Text="Appliquer sans redemarrer avant : le mapping echoue ou l'ancienne identite reste. Lancer le jeu avec une ligne rouge : l'anti-triche voit un composite moitie ancien moitie neuf, ce qui est pire que pas de spoof du tout. Oublier de restaurer avant de rendre la machine : la MAC spoofee reste dans le registre et la prochaine capture d'origine est faussee. Redemarrer en pleine session : retour immediat a l'empreinte d'origine."/>
                <TextBlock Text="APRES LA SESSION" Style="{StaticResource Mono}" Margin="0,14,0,6"/>
                <TextBlock TextWrapping="Wrap" FontSize="12" LineHeight="19" Foreground="{StaticResource Muted}" Text="Clique Restaurer avant d'eteindre, puis redemarre. La restauration remet la MAC d'origine et efface les hooks. Si tu doutes de l'etat, la commande de controle est dans le journal : la MAC doit revenir a sa valeur d'origine."/>
              </StackPanel>
            </Border>
            <Border Style="{StaticResource Card}" Margin="0,0,0,10">
              <StackPanel>
                <TextBlock Text="CE QUI EST REELLEMENT COUVERT" FontSize="14" FontWeight="SemiBold"/>
                <TextBlock TextWrapping="Wrap" FontSize="12" LineHeight="19" Foreground="{StaticResource Muted}" Margin="0,8,0,0" Text="SMBIOS (UUID, serie carte mere, serie BIOS, modele) via NtQuerySystemInformation. Serie disque via IOCTL_STORAGE_QUERY_PROPERTY. Serie volume via IRP_MJ_QUERY_VOLUME_INFORMATION, hook sur le systeme de fichiers. MAC via les OID NDIS et la cle NetworkAddress. MachineGuid et EDID dans le registre. Identifiant GPU par renommage de la cle Enum."/>
                <TextBlock TextWrapping="Wrap" FontSize="12" LineHeight="19" Foreground="{StaticResource Muted}" Margin="0,8,0,0" Text="NON couvert : TPM et son EK, etat Secure Boot, CPUID, SPD des barrettes, numero de serie grave dans la ROM du GPU, et surtout les lectures directes du firmware par un pilote noyau. Un anti-triche qui lit la memoire physique passe au-dessus de nos hooks."/>
                <TextBlock TextWrapping="Wrap" FontSize="12" LineHeight="19" Foreground="{StaticResource Muted}" Margin="0,8,0,0" Text="Le spoof est temporaire : rien sur disque, tout disparait au redemarrage. Il ne debannit pas un compte, il change l'empreinte pour un nouveau compte."/>
              </StackPanel>
            </Border>
            <Border Style="{StaticResource Card}" Margin="0,0,0,10">
              <StackPanel>
                <TextBlock Text="FICHE PAR JEU" FontSize="14" FontWeight="SemiBold"/>
                <TextBlock TextWrapping="Wrap" FontSize="11.5" Foreground="{StaticResource Muted}" Margin="0,8,0,0" Text="Chaque jeu, son anti-triche, le profil a armer. Le profil est un point de depart : si le jeu relit le materiel, armer davantage ne compense pas une lecture noyau."/>
                <Grid Margin="0,10,0,0">
                  <Grid.ColumnDefinitions><ColumnDefinition Width="260"/><ColumnDefinition Width="180"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                  <Grid.RowDefinitions><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/></Grid.RowDefinitions>
                  <TextBlock Grid.Row="0" Text="JEU" Style="{StaticResource Mono}"/><TextBlock Grid.Row="0" Grid.Column="1" Text="ANTI-TRICHE" Style="{StaticResource Mono}"/><TextBlock Grid.Row="0" Grid.Column="2" Text="PROFIL" Style="{StaticResource Mono}"/>
                  <TextBlock Grid.Row="1" Text="Apex Legends" Margin="0,4"/><TextBlock Grid.Row="1" Grid.Column="1" Text="EA Javelin" Margin="0,4" Foreground="{StaticResource Muted}"/><TextBlock Grid.Row="1" Grid.Column="2" Text="Javelin" Margin="0,4" Foreground="{StaticResource Accent2}"/>
                  <TextBlock Grid.Row="2" Text="Battlefield 6" Margin="0,4"/><TextBlock Grid.Row="2" Grid.Column="1" Text="EA Javelin" Margin="0,4" Foreground="{StaticResource Muted}"/><TextBlock Grid.Row="2" Grid.Column="2" Text="Javelin (Secure Boot requis)" Margin="0,4" Foreground="{StaticResource Accent2}"/>
                  <TextBlock Grid.Row="3" Text="EA SPORTS FC" Margin="0,4"/><TextBlock Grid.Row="3" Grid.Column="1" Text="EA Javelin" Margin="0,4" Foreground="{StaticResource Muted}"/><TextBlock Grid.Row="3" Grid.Column="2" Text="Javelin (Secure Boot requis)" Margin="0,4" Foreground="{StaticResource Accent2}"/>
                  <TextBlock Grid.Row="4" Text="Rust" Margin="0,4"/><TextBlock Grid.Row="4" Grid.Column="1" Text="Easy Anti-Cheat" Margin="0,4" Foreground="{StaticResource Muted}"/><TextBlock Grid.Row="4" Grid.Column="2" Text="EAC" Margin="0,4" Foreground="{StaticResource Accent2}"/>
                  <TextBlock Grid.Row="5" Text="Dead by Daylight" Margin="0,4"/><TextBlock Grid.Row="5" Grid.Column="1" Text="Easy Anti-Cheat" Margin="0,4" Foreground="{StaticResource Muted}"/><TextBlock Grid.Row="5" Grid.Column="2" Text="EAC" Margin="0,4" Foreground="{StaticResource Accent2}"/>
                  <TextBlock Grid.Row="6" Text="Fortnite" Margin="0,4"/><TextBlock Grid.Row="6" Grid.Column="1" Text="Easy Anti-Cheat" Margin="0,4" Foreground="{StaticResource Muted}"/><TextBlock Grid.Row="6" Grid.Column="2" Text="EAC" Margin="0,4" Foreground="{StaticResource Accent2}"/>
                  <TextBlock Grid.Row="7" Text="Halo Infinite" Margin="0,4"/><TextBlock Grid.Row="7" Grid.Column="1" Text="Easy Anti-Cheat" Margin="0,4" Foreground="{StaticResource Muted}"/><TextBlock Grid.Row="7" Grid.Column="2" Text="EAC" Margin="0,4" Foreground="{StaticResource Accent2}"/>
                  <TextBlock Grid.Row="8" Text="Naraka Bladepoint" Margin="0,4"/><TextBlock Grid.Row="8" Grid.Column="1" Text="Easy Anti-Cheat" Margin="0,4" Foreground="{StaticResource Muted}"/><TextBlock Grid.Row="8" Grid.Column="2" Text="EAC" Margin="0,4" Foreground="{StaticResource Accent2}"/>
                  <TextBlock Grid.Row="9" Text="The Finals" Margin="0,4"/><TextBlock Grid.Row="9" Grid.Column="1" Text="Easy Anti-Cheat" Margin="0,4" Foreground="{StaticResource Muted}"/><TextBlock Grid.Row="9" Grid.Column="2" Text="EAC" Margin="0,4" Foreground="{StaticResource Accent2}"/>
                  <TextBlock Grid.Row="10" Text="Rainbow Six Siege" Margin="0,4"/><TextBlock Grid.Row="10" Grid.Column="1" Text="BattlEye" Margin="0,4" Foreground="{StaticResource Muted}"/><TextBlock Grid.Row="10" Grid.Column="2" Text="BattlEye" Margin="0,4" Foreground="{StaticResource Accent2}"/>
                  <TextBlock Grid.Row="11" Text="PUBG" Margin="0,4"/><TextBlock Grid.Row="11" Grid.Column="1" Text="BattlEye" Margin="0,4" Foreground="{StaticResource Muted}"/><TextBlock Grid.Row="11" Grid.Column="2" Text="BattlEye" Margin="0,4" Foreground="{StaticResource Accent2}"/>
                  <TextBlock Grid.Row="12" Text="Escape from Tarkov" Margin="0,4"/><TextBlock Grid.Row="12" Grid.Column="1" Text="BattlEye" Margin="0,4" Foreground="{StaticResource Muted}"/><TextBlock Grid.Row="12" Grid.Column="2" Text="BattlEye" Margin="0,4" Foreground="{StaticResource Accent2}"/>
                  <TextBlock Grid.Row="13" Text="DayZ" Margin="0,4"/><TextBlock Grid.Row="13" Grid.Column="1" Text="BattlEye" Margin="0,4" Foreground="{StaticResource Muted}"/><TextBlock Grid.Row="13" Grid.Column="2" Text="BattlEye" Margin="0,4" Foreground="{StaticResource Accent2}"/>
                  <TextBlock Grid.Row="14" Text="Arma Reforger" Margin="0,4"/><TextBlock Grid.Row="14" Grid.Column="1" Text="BattlEye" Margin="0,4" Foreground="{StaticResource Muted}"/><TextBlock Grid.Row="14" Grid.Column="2" Text="BattlEye" Margin="0,4" Foreground="{StaticResource Accent2}"/>
                  <TextBlock Grid.Row="15" Text="Valorant" Margin="0,4"/><TextBlock Grid.Row="15" Grid.Column="1" Text="Vanguard" Margin="0,4" Foreground="{StaticResource Muted}"/><TextBlock Grid.Row="15" Grid.Column="2" Text="Vanguard (Secure Boot + TPM 2.0)" Margin="0,4" Foreground="{StaticResource Accent2}"/>
